# ---------------------------------------------------------------------------
# Prism Desk configuration. Copy to .env and edit, or export in your shell.
# EVERYTHING HERE IS OPTIONAL - Prism runs fully offline with zero keys.
# ---------------------------------------------------------------------------

# --- LLM (OpenAI-compatible). Leave unset to run in deterministic offline mode.
# Bitget Hackathon Qwen grant endpoint:
#   PRISM_LLM_BASE_URL=https://hackathon.bitgetops.com/v1
#   PRISM_LLM_MODEL=qwen3.8-max
PRISM_LLM_BASE_URL=
PRISM_LLM_API_KEY=
PRISM_LLM_MODEL=gpt-4o-mini

# --- Bitget MCP Server (US equities / ETF read-only data). No API key needed.
# Docs: https://bitget-ai.gitbook.io/bitgetai_hackathons2
PRISM_MCP_URL=https://agent.bitget.com/mcp
# auto | live | offline
#   auto    - try live, transparently fall back to bundled fixtures
#   live    - require the real endpoint (fail loudly)
#   offline - never touch the network; use bundled fixtures only
PRISM_DATA_MODE=auto

# --- Chainbase AgentKey (optional external partner data source)
# S2's external-partner data sponsorship: market data + on-chain + news + social
# behind one agent-facing endpoint. Entirely optional - with no key the provider
# reports state=disabled and issues no request, and every offline artefact in
# this repo is byte-identical to a build without it.
# The endpoint is issued together with your key (agentkey.app -> Get Started), so
# it has no default here; this repo does not guess someone else's URL.
CHAINBASE_AGENT_KEY=
CHAINBASE_MCP_URL=

# --- Server
PRISM_HOST=127.0.0.1
PRISM_PORT=4310